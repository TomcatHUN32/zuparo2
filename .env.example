# ========================================================
# SZESZTESTVÉREK & ZUPARO - PRODUKCIÓS KÖRNYEZETI VÁLTOZÓK (.env)
# ========================================================

# Database & Server settings
PORT=3000
NODE_ENV=production
TZ=Europe/Budapest

# MongoDB adatbázis kapcsolati sztring (helyi szerver)
MONGO_URI=mongodb://127.0.0.1:27017/szesztestverek

# Kompatibilitás miatt a MONGODB_URI is elfogadott
MONGODB_URI=mongodb://127.0.0.1:27017/szesztestverek

# JWT Titkos kulcs a bejelentkezési tokenek biztonságos aláírásához
JWT_SECRET=szesztestverek_jwt_secret_production_key_2026

# A weboldal / webshop nyilvános címe
APP_URL=https://rendeles.zuparo.hu

# Opcionális: Gemini AI API kulcs
GEMINI_API_KEY=

