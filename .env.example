# ========================================================
# ZUPARO RESTAURANT & POS - PRODUKCIÓS KÖRNYEZETI VÁLTOZÓK (.env)
# ========================================================

# Alkalmazás portja (Nginx ide fogja proxyzni a forgalmat)
PORT=3000

# Futtatási mód (production)
NODE_ENV=production

# Időzóna beállítása (Magyarországi éjféli záráshoz és rendelési időbélyegekhez)
TZ=Europe/Budapest

# MongoDB adatbázis kapcsolati sztring
# Helyi VPS telepítés esetén: mongodb://127.0.0.1:27017/zuparo
# MongoDB Atlas (Cloud) esetén: mongodb+srv://<felhasznalo>:<jelszo>@cluster.mongodb.net/zuparo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zuparo

# JWT Titkos kulcs a bejelentkezési tokenek biztonságos aláírásához (generálj egy hosszú, biztonságos karaktersorozatot)
JWT_SECRET=zuparo_super_secure_production_secret_key_change_me_987654321

# A weboldal / webshop nyilvános címe
APP_URL=https://rendeles.zuparo.hu

# Opcionális: Gemini AI API kulcs (ha automatikus leírás- vagy képfelismerést használsz)
GEMINI_API_KEY=

